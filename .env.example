# Required: Database & Cloud Storage (Supabase)
# PostgreSQL connection string (SQLAlchemy + psycopg v3 driver: postgresql+psycopg://...)
DATABASE_URL=

# Supabase project URL & service/API key (bucket: DocuMeet-bucket)
SUPABASE_URL=
SUPABASE_API_KEY=

# Required: Speech-to-Text & Primary LLM
# ElevenLabs STT (batch diarization & realtime WebSocket)
ELEVENLABS_API_KEY=

# Groq primary LLM (https://console.groq.com/keys)
GROQ_API_KEY=

# ==============================================================================
# Optional: Fallback LLM, Embeddings & Runtime Settings
# ==============================================================================
# OpenRouter fallback LLM (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

EMBED_URL=

MIA_DATA_DIR=data

SQLALCHEMY_ECHO=false
